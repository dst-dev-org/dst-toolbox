        "message": {
          "type": "string",
          "minLength": 1
        },
        "anchor_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "anchor_id"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "symbols": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "record_kinds": {
              "type": "array",
              "items": {
                "enum": [
                  "assignment",
                  "return",
                  "call",
                  "property_callback",
                  "method_alias",
                  "event_emit",
                  "event_listen",
                  "component_access",
                  "prefab_registration",
                  "comment"
                ]
              },
              "uniqueItems": true
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "symbols",
            "record_kinds",
            "description"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "status",
        "selection",
        "truncated",
        "diagnostics"
      ]
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "class",
            "constructor",
            "method",
            "function",
