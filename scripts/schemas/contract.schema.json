{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dst-wiki.local/contracts/interface-data/1.0.0",
  "title": "DST interface data contract 1.0.0",
  "description": "W01 contract. Example bundles contain separate facts, external candidates, reviews and a reproducible resolved cache.",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/facts"
    },
    {
      "$ref": "#/$defs/candidates"
    },
    {
      "$ref": "#/$defs/reviews"
    },
    {
      "$ref": "#/$defs/resolved"
    },
    {
      "$ref": "#/$defs/bundle"
    }
  ],
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbol_id": {
          "type": "string",
          "minLength": 1
        },
        "facet": {
          "type": "string",
          "pattern": "^(summary|aliases|field:type|param:(?:[A-Za-z_][A-Za-z0-9_]*|\\.\\.\\.):(type|optional)|returns|behavior:[a-z0-9-]+|relation:[a-z0-9-]+)$"
        }
      },
      "required": [
        "symbol_id",
        "facet"
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "byte",
        "line",
        "column"
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "enum": [
            "steam-buildid",
            "git-commit",
            "fixture"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scheme",
        "value"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encoding": {
          "const": "utf-8"
        }
      },
      "required": [
        "path",
        "sha256",
        "encoding"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "game-source",
            "annotation-library",
            "fixture"
          ]
        },
        "root_hint": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "root_hint",
        "revision",
        "files"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "extracted",
            "manual-reference",
            "synthetic"
          ]
        },
        "dialect": {
          "enum": [
            "lua51"
          ]
        },
        "parser": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "version"
              ]
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "mode",
        "dialect",
        "parser"
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "manifest"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "required": [
        "format_version",
        "kind",
        "snapshot",
        "producer",
        "sources"
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
        },
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "source_id",
        "path",
        "start",
        "end",
        "sha256"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
