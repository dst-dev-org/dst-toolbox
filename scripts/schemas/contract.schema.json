              "kind"
            ]
          }
        },
        "calling": {
          "enum": [
            "colon",
            "plain",
            "none"
          ]
        },
        "base_expression": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "scope",
        "owner_id",
        "anchor_id",
        "parameters",
        "calling",
        "base_expression"
      ]
